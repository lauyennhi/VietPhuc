# Khóa Gemini API — lấy tại https://aistudio.google.com/apikey
# Không có khóa app vẫn chạy ở chế độ dự phòng (không gọi Gemini).
GEMINI_API_KEY=

# Model văn bản / đọc ảnh (mặc định gemini-3.8-flash, dự phòng gemini-3.5-flash)
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# Model tạo ảnh "Nano Banana" (mặc định gemini-3.1-flash-image, dự phòng bản preview)
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_FALLBACK_MODEL=gemini-3.1-flash-image-preview

# Mức suy luận: off | minimal | low | medium | high (off = mặc định của model)
GEMINI_THINKING_LEVEL=off

PORT=3000

# Trần số ảnh AI toàn server mỗi giờ (bảo vệ hạn mức khi chia sẻ app)
VSTYLE_RENDER_HOURLY_CAP=120
